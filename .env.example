# Server Configuration
PORT=5000
NODE_ENV=development

# Security & CORS
# For mobile testing on the same Wi-Fi, append your LAN IP origin, e.g.:
#   http://192.168.1.16:3000
# Run: (Get-NetIPAddress -AddressFamily IPv4 -InterfaceAlias "Wi-Fi").IPAddress
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Organization Email Domain
# Only emails ending with this domain are accepted for all users (PRINCIPAL, HOD, TEACHER, STUDENT)
ORGANIZATION_EMAIL_DOMAIN=abcuniversity.edu.in

# PostgreSQL Database Connection (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_db?schema=public

# Redis Connection (Temporary Sessions, Caching, Rate Limiting)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
JWT_REFRESH_EXPIRY=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
